<!doctype html>
<html lang="{{ 'zh-CN' if language == 'zh' else 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    (function() {
      let storedTheme = null;
      try {
        storedTheme = localStorage.getItem('growth-mirror-theme');
      } catch (e) {
        console.warn('localStorage access failed, using In-Memory fallback.');
      }
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      let activeTheme = 'dark';
      if (storedTheme === 'dark' || storedTheme === 'light') {
        activeTheme = storedTheme;
      } else {
        activeTheme = prefersDark ? 'dark' : 'light';
      }
      if (activeTheme === 'dark') {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      } else {
        document.documentElement.classList.add('light');
        document.documentElement.classList.remove('dark');
      }
      window.__theme = activeTheme;
    })();
  </script>
  <title>{{ view.report_title }} - {{ view.tool_display_name }}</title>
  <style>
    {% include 'partials/report_theme.css.j2' %}
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: "Inter", "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      color: var(--ink);
      line-height: 1.6;
      background: var(--page-bg, var(--bg));
    }
    .page {
      max-width: 1440px;
      margin: 0 auto;
      padding: 32px 20px 64px;
    }
    .page-shell {
      display: block;
    }
    .page-main {
      min-width: 0;
    }
    .report-sidebar {
      display: none;
    }
    .sidebar-card {
      border-radius: 24px;
      padding: 18px 16px;
      background: var(--sidebar-bg);
      border: 1px solid var(--sidebar-border);
      box-shadow: 0 16px 34px rgba(99, 102, 241, 0.08);
      backdrop-filter: blur(12px);
    }
    .sidebar-subtitle {
      margin: 0 0 12px;
      font-size: 0.78rem;
      color: var(--muted);
    }
    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .sidebar-nav-link {
      text-decoration: none;
      color: var(--sidebar-link-ink);
      border: 1px solid var(--sidebar-link-border);
      background: var(--sidebar-link-bg);
      padding: 10px 12px;
      border-radius: 14px;
      font-size: 0.86rem;
      font-weight: 700;
      transition: all 0.18s ease;
    }
    .sidebar-nav-link:hover,
    .sidebar-nav-link.active {
      color: #fff;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-warm) 55%, var(--accent-light) 100%);
      border-color: transparent;
      box-shadow: 0 10px 22px rgba(124, 58, 237, 0.24);
    }
    .hero {
      border-radius: 28px;
      padding: 32px 32px 28px;
      box-shadow: var(--shadow);
      position: relative;
      overflow: hidden;
      isolation: isolate;
      scroll-margin-top: 28px;
    }
    .hero > * { position: relative; z-index: 1; }
    .hero-shell {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.55fr);
      gap: 22px;
      align-items: start;
    }
    .hero-copy {
      min-width: 0;
    }
    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }
    .sidebar-brand-link {
      text-decoration: none;
      color: inherit;
      transition: opacity 0.15s ease;
    }
    .sidebar-brand-link:hover {
      opacity: 0.78;
    }
    .sidebar-brand-link:hover .sidebar-brand-name {
      color: var(--accent);
    }
    .sidebar-brand-mark {
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      line-height: 0;
    }
    .sidebar-brand-mark svg,
    .hero-brand-compact-mark svg {
      display: block;
      width: 100%;
      height: auto;
    }
    .sidebar-brand-copy {
      min-width: 0;
    }
    .sidebar-brand-name {
      margin: 0;
      font-size: 0.98rem;
      font-weight: 800;
      color: var(--ink);
      letter-spacing: -0.02em;
    }
    .sidebar-brand-caption {
      margin: 2px 0 0;
      font-size: 0.72rem;
      color: var(--muted);
    }
    .hero-brand-compact {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }
    .hero-brand-compact-mark {
      width: 36px;
      height: 36px;
      flex: 0 0 36px;
      line-height: 0;
    }
    .hero-brand-compact-name {
      margin: 0;
      font-size: 0.9rem;
      font-weight: 800;
      color: var(--hero-ink);
      letter-spacing: -0.02em;
      line-height: 1.1;
    }
    .hero-brand-compact-caption {
      margin: 3px 0 0;
      font-size: 0.72rem;
      color: var(--hero-muted);
      line-height: 1.2;
    }
    .hero-badge {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
      padding: 20px;
      border-radius: 22px;
      background: var(--card-bg);
      border: 1px solid var(--border-active, rgba(167, 139, 250, 0.42));
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.05),
        0 16px 34px rgba(0, 0, 0, 0.3);
    }
    .hero-badge-main {
      display: flex;
      align-items: flex-end;
      gap: 10px;
    }
    .hero-badge-level {
      font-size: clamp(2.8rem, 6vw, 4.6rem);
      line-height: 0.9;
      font-weight: 900;
      letter-spacing: -0.06em;
      background: var(--hero-level-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-badge-note {
      margin-top: 12px;
      font-size: 0.86rem;
      line-height: 1.6;
      color: var(--hero-muted);
    }
    .hero-badge-level-detail {
      margin-top: 8px;
      font-size: 0.8rem;
      line-height: 1.6;
      color: var(--hero-muted);
    }
    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 12px;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--hero-chip-ink);
      background: var(--hero-chip-bg);
      border: 1px solid var(--hero-chip-border);
    }
    .hero h1 {
      margin: 0 0 10px;
      font-size: 36px;
      line-height: 1.15;
      letter-spacing: -0.03em;
      color: var(--hero-ink);
    }
    .hero-headline {
      margin: 0;
      max-width: 62ch;
      font-size: 1.02rem;
      color: color-mix(in srgb, var(--hero-ink) 82%, var(--accent-strong));
    }
    .hero p { margin: 0; color: var(--hero-muted); }
    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 20px;
    }
    .hero-usage {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
      margin-top: 18px;
    }
    .hero-usage-card {
      background: var(--hero-glass);
      border: 1px solid var(--hero-glass-border);
      border-radius: 16px;
      padding: 14px 14px 12px;
      box-shadow: var(--hero-card-shadow);
    }
    .hero-usage-label {
      font-size: 0.78rem;
      color: var(--hero-muted);
      margin-bottom: 8px;
    }
    .hero-usage-value {
      color: var(--hero-ink);
      font-size: 1.2rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 4px;
    }
    .hero-usage-detail {
      font-size: 0.74rem;
      color: var(--hero-muted);
      line-height: 1.45;
    }
    .chip {
      background: var(--hero-chip-bg);
      border: 1px solid var(--hero-chip-border);
      color: var(--hero-chip-ink);
      padding: 8px 12px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      box-shadow: 0 4px 14px rgba(124, 58, 237, 0.08);
    }
    .hero-meta .chip:first-child {
      background: linear-gradient(135deg, rgba(124, 58, 237, 0.12), rgba(167, 139, 250, 0.12));
      border-color: rgba(124, 58, 237, 0.28);
    }
    .hero-kpis {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 14px;
      margin-top: 24px;
    }
    .hero-kpi {
      background: var(--hero-glass);
      border: 1px solid var(--hero-glass-border);
      border-radius: 16px;
      padding: 16px;
      box-shadow: var(--hero-card-shadow);
      position: relative;
      overflow: hidden;
    }
    .hero-kpi::after {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 3px;
      background: linear-gradient(90deg, rgba(124,58,237,0.95), rgba(59,130,246,0.55));
      opacity: 0.55;
    }
    .hero-kpi-value { font-size: 28px; font-weight: 700; margin-bottom: 4px; }
    .hero-kpi-num {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 4px;
      background: var(--hero-num-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-kpi-label { font-size: 13px; color: var(--hero-muted); }
    .section {
      margin-top: 22px;
      background: var(--section-bg);
      border: 1px solid var(--section-border);
      border-radius: 24px;
      padding: 26px;
      box-shadow: 0 18px 40px rgba(124, 58, 237, 0.08);
      scroll-margin-top: 28px;
      backdrop-filter: blur(8px);
      position: relative;
      overflow: hidden;
      scroll-margin-top: 24px;
    }
    .section::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      height: 4px;
      background: var(--section-accent);
    }
    .section h2 { margin: 0 0 8px; font-size: 25px; }
    .section-sub {
      margin: 0 0 18px;
      color: var(--muted);
      font-size: 0.94rem;
    }
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 18px;
    }
    .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; }
    .card {
      border: 1px solid var(--card-border);
      border-radius: 18px;
      padding: 18px;
      background: var(--card-bg);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.05),
        0 6px 18px rgba(0, 0, 0, 0.2);
    }
    .metric {
      margin-top: 14px;
    }
    .metric-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      font-size: 14px;
      margin-bottom: 6px;
    }
    .bar {
      height: 10px;
      background: var(--separator);
      border-radius: 999px;
      overflow: hidden;
    }
    .bar > span {
      display: block;
      height: 100%;
      border-radius: 999px;
    }
    .small {
      color: var(--muted);
      font-size: 14px;
    }
    .muted { color: var(--muted); }
    .list { margin: 0; padding-left: 18px; }
    .list li { margin-bottom: 8px; }
    .note {
      background: var(--note-bg);
      color: var(--ink);
      border-radius: 14px;
      padding: 14px 16px;
      border: 1px solid var(--note-border);
      margin-bottom: 16px;
    }
    .note--warn {
      background: var(--note-warn-bg);
      border-color: var(--note-warn-border);
    }
    .note--growth {
      background: var(--note-growth-bg);
      border-color: var(--note-growth-border);
    }
    .code {
      background: var(--code-bg);
      color: var(--code-fg);
      border-radius: 16px;
      padding: 16px;
      white-space: pre-wrap;
      word-break: break-word;
      font-family: Consolas, "SFMono-Regular", monospace;
      font-size: 13px;
    }
    .pill {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 999px;
      background: var(--pill-bg);
      color: var(--pill-fg);
      font-size: 12px;
      margin-right: 8px;
      margin-bottom: 8px;
    }
    .tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 18px;
    }
    .tab-btn {
      border: 1px solid var(--line);
      background: var(--sidebar-link-bg, #fff);
      color: var(--ink);
      padding: 10px 14px;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 600;
    }
    .tab-btn:hover:not(.active) {
      background: var(--accent-soft);
      border-color: var(--accent);
      color: var(--accent-strong);
    }
    .tab-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    .card-grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
    }
    .eyebrow {
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .footer {
      margin-top: 24px;
      padding-top: 18px;
      border-top: 1px solid var(--line, rgba(148,163,184,0.24));
      color: var(--muted);
      font-size: 13px;
      text-align: center;
      line-height: 1.9;
    }
    .footer-meta {
      margin-top: 6px;
    }
    .footer a {
      color: var(--accent-strong, #6d28d9);
      text-decoration: none;
    }
    .footer a:hover {
      text-decoration: underline;
    }
    .footer-sep {
      margin: 0 6px;
      opacity: 0.55;
    }
    .section-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 18px 0 0;
    }
    .section-nav a {
      text-decoration: none;
      color: var(--hero-nav-ink);
      border: 1px solid var(--hero-nav-border);
      background: var(--hero-nav-bg);
      padding: 8px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .section-nav a:hover,
    .section-nav a.active {
      background: var(--hero-nav-active-bg);
      border-color: var(--hero-nav-active-border);
      color: var(--hero-nav-active-ink);
      box-shadow: 0 8px 18px hsla(var(--h-primary), 70%, 50%, 0.18);
    }
    .overview-band {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      margin-top: 18px;
    }
    .overview-card {
      border-radius: 18px;
      padding: 18px;
      border: 1px solid var(--hero-glass-border);
      background: var(--hero-glass);
      box-shadow: var(--hero-card-shadow);
    }
    .overview-card--signal {
      background: var(--overview-signal-bg);
      border-color: color-mix(in srgb, var(--growth) 26%, transparent);
    }
    .overview-card--signal h3 { color: var(--growth); }
    .overview-card--focus {
      background: var(--overview-focus-bg);
      border-color: color-mix(in srgb, var(--friction) 28%, transparent);
    }
    .overview-card--focus h3 { color: var(--friction); }
    .overview-card--method {
      background: var(--overview-method-bg);
      border-color: color-mix(in srgb, var(--accent) 26%, transparent);
    }
    .overview-card--method h3 { color: var(--accent-strong); }
    .overview-card h3 {
      margin: 0 0 8px;
      font-size: 0.9rem;
      color: var(--hero-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .overview-card p {
      margin: 0;
      color: var(--hero-ink);
      font-size: 0.95rem;
    }
    .overview-list {
      margin: 0;
      padding-left: 18px;
      color: var(--hero-ink);
      font-size: 0.87rem;
    }
    .overview-list li { margin-bottom: 6px; }
    .hero-usage-inline {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-top: 16px;
    }
    .hero-usage-inline-item {
      min-width: 0;
      background: var(--hero-glass);
      border: 1px solid var(--hero-glass-border);
      border-radius: 16px;
      padding: 14px 14px 12px;
      box-shadow: var(--hero-card-shadow);
    }
    .hero-usage-inline-item:nth-child(1) { border-top: 3px solid var(--accent); }
    .hero-usage-inline-item:nth-child(2) { border-top: 3px solid var(--accent-light); }
    .hero-usage-inline-item:nth-child(3) { border-top: 3px solid var(--growth); }
    .hero-usage-inline-item:nth-child(4) { border-top: 3px solid var(--friction); }
    .hero-usage-inline-value {
      font-size: 1.22rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 4px;
      background: var(--hero-num-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-usage-inline-label {
      font-size: 0.78rem;
      color: var(--hero-muted);
      margin-bottom: 8px;
    }
    .hero-usage-inline-detail {
      font-size: 0.74rem;
      color: var(--hero-muted);
      line-height: 1.45;
      word-break: break-word;
    }
    .usage-inline {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 22px;
      margin-top: 16px;
    }
    .usage-inline-item {
      padding: 14px 0;
      border-bottom: 1px solid var(--separator);
    }
    .usage-inline-label {
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .usage-inline-value {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--ink);
      margin-bottom: 4px;
    }
    .usage-inline-detail {
      font-size: 0.78rem;
      color: var(--muted);
      line-height: 1.5;
    }
    .focus-strip {
      margin-top: 14px;
      padding: 14px 18px 14px 20px;
      border-radius: 16px;
      background: var(--hero-strip-bg);
      border: 1px solid var(--hero-strip-border);
      border-left: 4px solid var(--accent);
      color: var(--hero-ink);
      font-size: 0.95rem;
      font-weight: 600;
    }
    .usage-footnotes {
      margin-top: 12px;
      padding: 12px 14px;
      border-radius: 14px;
      background: var(--accent-soft);
      border: 1px solid color-mix(in srgb, var(--accent) 16%, transparent);
    }
    .usage-footnote {
      margin: 0;
      font-size: 0.82rem;
      line-height: 1.55;
      color: var(--hero-muted);
    }
    .usage-footnote--scope {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 10px;
      align-items: baseline;
      color: var(--hero-ink);
    }
    .usage-footnote-kicker {
      flex: 0 0 auto;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--accent-strong);
    }
    .evidence-summary {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      margin-bottom: 16px;
    }
    .evidence-summary .card {
      background: linear-gradient(180deg, var(--card-bg) 0%, hsla(var(--h-neutral, 220), 30%, 10%, 0.8) 100%);
    }
    .summary-kicker {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .progress-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent-strong);
      font-size: 12px;
      font-weight: 700;
    }
    @media (max-width: 1199px) {
      .report-sidebar { display: none; }
    }
    @media (min-width: 1200px) {
      .hero-brand-compact {
        display: none;
      }
      .page-shell {
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
        gap: 24px;
        align-items: stretch;
      }
      .report-sidebar {
        display: block;
      }
      .sidebar-card {
        position: sticky;
        top: 24px;
        max-height: calc(100vh - 48px);
        overflow-y: auto;
      }
      .section-nav {
        display: none;
      }
    }
    @media (max-width: 720px) {
      .page { padding: 18px 14px 48px; }
      .hero, .section { padding: 20px; border-radius: 20px; }
      .hero h1 { font-size: 28px; }
      .hero-shell { grid-template-columns: 1fr; }
      .hero-brand-compact-name { font-size: 0.84rem; }
      .hero-badge { padding: 16px; }
      .hero-usage {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .hero-usage-inline {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .usage-inline {
        grid-template-columns: 1fr;
      }
    }
    /* UX Polish */
    .section-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.12rem;
      font-weight: 800;
      color: var(--ink);
      letter-spacing: -0.01em;
    }
    .section-title::before {
      content: "";
      width: 5px;
      height: 1.1em;
      border-radius: 999px;
      background: var(--section-accent);
      box-shadow: 0 0 0 3px hsla(var(--h-primary), 70%, 50%, 0.1);
    }
    .data-num {
      font-size: 1.6rem;
      font-weight: 800;
      line-height: 1;
      color: var(--ink);
    }
    .meta-text {
      font-size: 0.78rem;
      color: var(--evidence-unmet);
      line-height: 1.4;
    }
    .badge-level {
      display: inline-block;
      padding: 0.3rem 0.9rem;
      border-radius: 0.5rem;
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: 0.05em;
    }
    .hero-score {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--ink);
      line-height: 1;
    }
    .hero-subtitle {
      font-size: 0.85rem;
      color: var(--muted);
    }
    .hero-kpi-label-light {
      font-size: 0.85rem;
      color: var(--hero-muted);
    }
    .evidence-list { margin-top: 8px; }
    .evidence-row {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      padding: 8px 0;
      border-bottom: 1px solid var(--separator);
    }
    .evidence-icon {
      font-size: 0.9rem;
      min-width: 20px;
      margin-top: 2px;
    }
    .evidence-icon.met { color: var(--evidence-met); }
    .evidence-icon.unmet { color: var(--evidence-unmet); }
    .evidence-body { flex: 1; }
    .evidence-label {
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--ink);
    }
    .evidence-signal {
      font-size: 0.75rem;
      color: var(--evidence-unmet);
      margin-top: 2px;
    }
    .evidence-divider {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 14px 0 4px;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--hero-muted);
    }
    .evidence-divider span {
      padding: 2px 8px;
      border: 1px solid var(--accent-soft);
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent);
    }
    .evidence-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--separator);
    }
    .evidence-divider--system span {
      color: var(--system-text);
      background: var(--system-bg);
      border-color: var(--system-border);
    }
    .evidence-row--system_layer {
      background: var(--system-bg);
      border-radius: 10px;
      padding: 12px;
      border: 1px solid var(--system-border);
    }
    .coach-card {
      background: var(--card-bg);
      border: 1px solid var(--border-active, var(--card-border));
      border-radius: 18px;
      padding: 18px;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.05),
        0 6px 18px rgba(0, 0, 0, 0.2);
    }
    .coach-headline {
      font-size: 1rem;
      font-weight: 700;
      color: var(--ink);
    }
    .coach-evidence {
      font-size: 0.8rem;
      color: var(--muted);
    }
    .coach-tip {
      font-size: 0.875rem;
      line-height: 1.6;
    }
    .exemplar-title {
      font-size: 1rem;
      font-weight: 600;
      color: var(--ink);
      margin: 8px 0 6px;
    }
    .exemplar-facts {
      font-size: 0.75rem;
      color: var(--evidence-unmet);
      margin: 0 0 10px;
    }
    .technique-chip {
      display: inline-block;
      background: var(--accent-soft);
      color: var(--pill-fg);
      border-radius: 0.25rem;
      padding: 4px 10px;
      font-size: 0.8rem;
      margin-top: 8px;
    }
    .score-value {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--ink);
    }
    .advanced-features {
      margin-top: 18px;
      padding: 14px 16px;
      border-radius: 16px;
      background: var(--accent-soft, rgba(124, 58, 237, 0.06));
      border: 1px solid rgba(124, 58, 237, 0.16);
    }
    .advanced-features-head {
      margin-bottom: 6px;
      font-size: 0.92rem;
    }
    .advanced-features-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 10px;
    }
    .advanced-feature-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: 999px;
      background: var(--pill-bg);
      border: 1px solid var(--border-active, rgba(124, 58, 237, 0.22));
      font-size: 0.82rem;
      color: var(--pill-fg);
      font-weight: 600;
    }
    .advanced-feature-chip em {
      font-style: normal;
      font-weight: 700;
      color: var(--accent);
    }
    .priority-why {
      margin: 0 0 14px;
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.65;
    }
    .theme-link {
      color: var(--accent-strong);
      font-size: 0.9rem;
      font-weight: 700;
      list-style: none;
    }
    details summary::-webkit-details-marker { display: none; }
    details summary::marker { content: ""; }
    .kpi-label {
      font-size: 0.78rem;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .kpi-value {
      font-size: 1.8rem;
      font-weight: 800;
      line-height: 1;
      color: var(--ink);
    }
    .section-toggle {
      margin-top: 14px;
      padding-top: 0;
      border-top: none;
      background: var(--section-bg);
      border: 1px solid var(--section-border);
      border-radius: 18px;
      padding: 10px 12px 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }
    .section-toggle > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      padding: 12px 14px;
      border-radius: 14px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
      cursor: pointer;
    }
    .section-toggle > summary:hover {
      background: var(--sidebar-link-border);
      border-color: var(--border-active);
    }
    .section-toggle > summary::after {
      content: "+";
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent-strong);
      font-weight: 800;
      line-height: 1;
      flex: 0 0 24px;
    }
    .section-toggle[open] > summary::after {
      content: "−";
    }
    .section-toggle > :not(summary) {
      margin-top: 14px;
    }
    @keyframes gold-ripple {
      0% {
        border-color: #fbbf24;
        box-shadow: 0 0 0 0px rgba(251, 191, 36, 0.7), 0 16px 34px rgba(99, 102, 241, 0.08);
      }
      50% {
        border-color: #f59e0b;
        box-shadow: 0 0 0 12px rgba(251, 191, 36, 0), 0 16px 34px rgba(99, 102, 241, 0.12);
      }
      100% {
        border-color: var(--card-border);
        box-shadow: 0 0 0 0px rgba(251, 191, 36, 0), 0 6px 18px rgba(0, 0, 0, 0.2);
      }
    }
    .card-highlight {
      animation: gold-ripple 1.5s ease-out;
      border-color: #fbbf24 !important;
      box-shadow: 0 0 0 4px rgba(251, 191, 36, 0.2) !important;
      transition: all 0.3s ease;
    }
    .radar-hover-zone {
      fill: transparent;
      transition: fill 0.2s ease;
    }
    .radar-hover-zone:hover {
      fill: hsla(var(--h-primary), 70%, 50%, 0.08);
    }
    .radar-tooltip {
      background: var(--card-bg);
      border: 1px solid var(--border-active, var(--card-border));
      border-radius: 12px;
      padding: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
      color: var(--ink);
      font-size: 0.82rem;
      max-width: 240px;
      line-height: 1.5;
      backdrop-filter: blur(8px);
      transition: opacity 0.15s ease;
      opacity: 0;
    }
    .radar-tooltip-title {
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--accent);
      margin-bottom: 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .radar-tooltip-score {
      background: var(--accent-soft);
      color: var(--accent-strong);
      padding: 2px 6px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 800;
    }
    .radar-tooltip-reason {
      color: var(--muted);
      font-size: 0.78rem;
    }
    .theme-toggle-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 10px 14px;
      border-radius: 14px;
      background: var(--sidebar-link-bg);
      border: 1px solid var(--sidebar-link-border);
      color: var(--sidebar-link-ink);
      font-size: 0.86rem;
      font-weight: 700;
      cursor: pointer;
      text-align: left;
      transition: all 0.18s ease;
    }
    .theme-toggle-btn:hover {
      background: var(--sidebar-link-border);
      border-color: var(--border-active);
      color: var(--ink);
    }
    .jump-link {
      cursor: pointer;
      text-decoration: underline;
      color: var(--link);
      transition: color 0.18s ease;
    }
    .jump-link:hover {
      color: var(--accent-strong);
    }
  </style>
</head>
<body>
  <div id="radar-tooltip" class="radar-tooltip" style="display: none; position: absolute; pointer-events: none; z-index: 1000;"></div>
  <div class="page">
    <div class="page-shell">
    <aside class="report-sidebar" aria-label="报告导航">
      <div class="sidebar-card">
        <a class="sidebar-brand sidebar-brand-link" href="#section-summary" aria-label="AI 成长镜 · 回到报告顶部">
          <div class="sidebar-brand-mark">
            {% include 'logo/ai-growth-mirror-logo-primary.svg' %}
          </div>
          <div class="sidebar-brand-copy">
            <p class="sidebar-brand-name">AI 成长镜</p>
            <p class="sidebar-brand-caption">AI Growth Mirror</p>
          </div>
        </a>
        <p class="sidebar-subtitle">{{ view.tool_display_name }}</p>
        <nav class="sidebar-nav">
          {% for section in view.sections if section.nav_visible %}
          <a class="sidebar-nav-link" href="#{{ section.id }}">{{ section.label }}</a>
          {% endfor %}
        </nav>
        <div class="sidebar-theme-toggle" style="margin-top: 16px; padding: 0 4px;">
          <button id="theme-toggle-btn" class="theme-toggle-btn" aria-label="切换主题">
            <span class="theme-toggle-icon">🌓</span>
            <span class="theme-toggle-label">{{ view.labels.get('label_theme_toggle', '主题模式') }}: <span id="theme-toggle-status">Auto</span></span>
          </button>
        </div>
      </div>
    </aside>
    <div class="page-main">
    <section class="hero" id="section-summary">
      <div class="hero-shell">
        <div class="hero-copy">
          <div class="hero-brand-compact" aria-label="AI Growth Mirror">
            <div class="hero-brand-compact-mark">
              {% include 'logo/ai-growth-mirror-logo-primary.svg' %}
            </div>
            <div style="flex: 1;">
              <p class="hero-brand-compact-name">AI Growth Mirror</p>
              <p class="hero-brand-compact-caption">AI 成长镜</p>
            </div>
            <button id="mobile-theme-toggle" class="theme-toggle-btn" style="width: auto; padding: 8px 12px; margin-left: auto;" aria-label="切换主题">
              <span>🌓</span>
            </button>
          </div>
          <p class="hero-eyebrow">{{ view.summary.subtitle }}</p>
          <h1>{{ view.summary.title }}</h1>
          <div class="hero-meta">
            {% for chip in view.summary.chips %}
            <span class="chip">{{ chip.label }}: {{ chip.value }}</span>
            {% endfor %}
          </div>
          <div class="hero-kpis">
            <div class="hero-kpi">
              <div class="hero-kpi-num">{{ view.summary.score_display or view.summary.mirror_score }}</div>
              <div class="hero-kpi-label-light">{{ view.labels['label_score'] }}</div>
            </div>
            <div class="hero-kpi">
              <div class="hero-kpi-num">{{ view.summary.session_count }}</div>
              <div class="hero-kpi-label-light">{{ view.labels['label_sample_sessions'] }}</div>
            </div>
            <div class="hero-kpi">
              <div class="hero-kpi-num">{{ view.summary.active_days }}</div>
              <div class="hero-kpi-label-light">{{ view.labels['label_active_days'] }}</div>
            </div>
          </div>
        </div>
        <aside class="hero-badge" aria-label="hero highlight">
          <div>
            <div class="hero-badge-main">
              <div class="hero-badge-level">{{ view.summary.growth_level }}</div>
            </div>
            <p class="hero-badge-note">{{ view.summary.headline }}</p>
          </div>
        </aside>
      </div>
      <div class="focus-strip">{{ view.level_evidence.progress_summary }}</div>
      <div class="overview-band">
        <div class="overview-card overview-card--signal">
          <h3>{{ view.labels['label_overview_current'] }}</h3>
          <p>{{ view.summary.strongest_signal }}</p>
        </div>
        <div class="overview-card overview-card--focus">
          <h3>{{ view.labels['label_overview_target'] }}</h3>
          <p>{{ view.summary.next_focus }}</p>
        </div>
        <div class="overview-card overview-card--method">
          <h3>{{ view.labels['label_overview_method'] }}</h3>
          <ul class="overview-list">
            {% for line in view.level_evidence.methodology_lines[:2] %}
            <li>{{ line }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {% if view.usage.stats %}
      <div class="hero-usage-inline" aria-label="{{ view.labels['section_usage'] }}">
        {% for item in view.usage.stats %}
        <div class="hero-usage-inline-item">
          <div class="hero-usage-inline-label">{{ item.label }}</div>
          <div class="hero-usage-inline-value">{{ item.value }}</div>
          {% if item.detail %}
          <div class="hero-usage-inline-detail">{{ item.detail }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% if view.usage.coverage_note %}
      <div class="usage-footnotes" role="note" aria-label="{{ view.labels.get('label_usage_scope', '数据口径') }}">
        <p class="usage-footnote usage-footnote--scope">
          <span class="usage-footnote-kicker">{{ view.labels.get('label_usage_scope', '数据口径') }}</span>
          <span>{{ view.usage.coverage_note }}</span>
        </p>
      </div>
      {% endif %}
      {% endif %}
      <div class="section-nav">
        {% for section in view.sections if section.nav_visible %}
        <a class="section-nav-link" href="#{{ section.id }}">{{ section.label }}</a>
        {% endfor %}
      </div>
    </section>

    <section class="section" id="section-growth-signals">
      <h2 class="section-title">{{ view.labels['section_growth_signals'] }}</h2>
      {% if view.growth_stage %}
      <div class="note">
        <strong>{{ view.growth_stage.label }}</strong> · {{ view.growth_stage.summary }}
        <div style="margin-top:8px;">
          <span class="pill">{{ view.labels['label_strongest_axis'] }}：{{ view.growth_stage.strongest_axis }}</span>
          <span class="pill">{{ view.labels['label_primary_gap'] }}：{{ view.growth_stage.primary_gap }}</span>
          <span class="pill">{{ view.labels['label_next_breakthrough'] }}：{{ view.growth_stage.next_breakthrough }}</span>
        </div>
      </div>
      {% endif %}
      <div class="grid-2">
        <div class="card">
          <h3>{{ view.labels['section_capability'] }}</h3>
          {% if view.growth_stage %}
          <p class="small">{{ view.growth_stage.summary }}</p>
          {% endif %}
          {% if view.radar_chart %}
          <div style="display:flex; justify-content:center; margin:8px 0 14px;">
            <svg width="320" height="320" viewBox="0 0 {{ view.radar_chart.size }} {{ view.radar_chart.size }}" role="img" aria-label="{{ view.labels['section_capability'] }}">
              {% for polygon in view.radar_chart.grid_polygons %}
              <polygon points="{{ polygon }}" fill="none" style="stroke: var(--chart-grid);" stroke-width="1"></polygon>
              {% endfor %}
              {% for line in view.radar_chart.axis_lines %}
              {% set parts = line.split(' ') %}
              {% set p1 = parts[0].split(',') %}
              {% set p2 = parts[1].split(',') %}
              <line x1="{{ p1[0] }}" y1="{{ p1[1] }}" x2="{{ p2[0] }}" y2="{{ p2[1] }}" style="stroke: var(--chart-line);" stroke-width="1"></line>
              {% endfor %}
              <polygon points="{{ view.radar_chart.polygon_points }}" style="fill: var(--chart-fill); stroke: var(--chart-stroke);" stroke-width="2"></polygon>
              {% for point in view.radar_chart.polygon_points.split(' ') %}
              {% set xy = point.split(',') %}
              <circle cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="3.5" style="fill: var(--chart-stroke);"></circle>
              {% endfor %}
              {% for item in view.radar_chart.label_positions %}
              <text x="{{ item.x }}" y="{{ item.y }}" text-anchor="middle" font-size="11" font-weight="700" fill="var(--ink)">{{ item.label }}</text>
              {% endfor %}
              {% for zone in view.radar_chart.hover_zones %}
              <polygon class="radar-hover-zone" data-key="{{ zone.key }}" data-label="{{ zone.label }}" data-score="{{ '%.1f'|format(zone.score) }}" data-reason="{{ zone.short_reason }}" points="{{ zone.points }}"></polygon>
              {% endfor %}
            </svg>
          </div>
          {% if view.growth_trajectory and view.growth_trajectory.available and view.growth_trajectory.trend and view.growth_trajectory.trend.score_series %}
            {% set series = view.growth_trajectory.trend.score_series %}
            <div class="trend-section" style="margin-top: 16px; border-top: 1px solid var(--separator); padding-top: 16px; width: 100%;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 0.95em; font-weight: bold; color: var(--ink);">{{ view.labels.get('label_score_trend', 'Mirror Score 近期趋势') }}</span>
                {% set delta = view.growth_trajectory.data.score_delta %}
                <span class="trend-badge {% if delta > 0 %}trend-up{% elif delta < 0 %}trend-down{% else %}trend-flat{% endif %}" 
                      style="font-size: 0.85em; font-weight: bold; display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 4px; 
                             background-color: {% if delta > 0 %}rgba(16,185,129,0.1){% elif delta < 0 %}rgba(239,68,68,0.1){% else %}rgba(156,163,175,0.1){% endif %};
                             color: {% if delta > 0 %}var(--success, #10b981){% elif delta < 0 %}var(--danger, #ef4444){% else %}var(--text-muted, #6b7280){% endif %};">
                  {% if delta > 0 %}
                    <span style="font-size: 1.1em;">↑</span> {{ delta | round(0) }} 分
                  {% elif delta < 0 %}
                    <span style="font-size: 1.1em;">↓</span> {{ delta | round(0) }} 分
                  {% else %}
                    <span style="font-size: 1.1em;">→</span> 持平
                  {% endif %}
                </span>
              </div>
              <div style="position: relative; display: flex; justify-content: center; width: 100%;">
                <svg width="300" height="120" viewBox="0 0 300 120" style="overflow: visible;">
                  <defs>
                    <linearGradient id="trend-area-grad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--accent, #4f46e5)"></stop>
                      <stop offset="100%" stop-color="var(--accent, #4f46e5)" stop-opacity="0"></stop>
                    </linearGradient>
                  </defs>
                  {% for tick in series.y_ticks %}
                  <line x1="12" y1="{{ tick.y }}" x2="288" y2="{{ tick.y }}" style="stroke: var(--chart-grid, #e5e7eb);" stroke-dasharray="3,3" stroke-width="1"></line>
                  <text x="0" y="{{ tick.y + 3 }}" font-size="8" fill="var(--text-muted, #9ca3af)">{{ tick.value | round(0) }}</text>
                  {% endfor %}
                  {% if series.area_path %}
                  <path d="{{ series.area_path }}" fill="url(#trend-area-grad)" opacity="0.15"></path>
                  {% endif %}
                  {% if series.polyline %}
                  <path d="M {{ series.polyline }}" fill="none" stroke="var(--accent, #4f46e5)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  {% endif %}
                  {% set last_points = series.points[-10:] %}
                  {% for pt in last_points %}
                  <circle cx="{{ pt.x }}" cy="{{ pt.y }}" r="4" class="trend-point" 
                          data-date="{{ pt.date }}" data-val="{{ pt.value }}"
                          style="fill: var(--accent, #4f46e5); stroke: var(--bg, #ffffff); stroke-width: 2; cursor: pointer;"></circle>
                  {% endfor %}
                </svg>
                <div class="trend-tooltip" style="display: none; position: absolute; pointer-events: none; z-index: 1001; 
                                                 background: rgba(15, 23, 42, 0.9); color: #fff; padding: 6px 10px; border-radius: 4px; 
                                                 font-size: 10px; font-family: monospace; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
                </div>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 9px; color: var(--text-muted, #9ca3af); margin-top: 6px; padding: 0 12px;">
                <span>{{ series.start_label }}</span>
                <span>{{ series.end_label }}</span>
              </div>
            </div>
          {% endif %}
          {% endif %}
        </div>
        <div class="grid-1" style="display:grid; gap:16px;">
          <div class="card">
            <h3>{{ view.labels['label_gap_rankings'] }}</h3>
            {% for gap in view.gap_rankings[:3] %}
            <div style="padding:10px 0; border-bottom:1px solid var(--separator);">
              <div style="display:flex; justify-content:space-between; gap:12px;">
                <strong class="jump-link" data-target="{{ gap.key }}">{{ gap.label }}</strong>
                <span class="pill">Top {{ gap.rank }}</span>
              </div>
              <p class="meta-text">{{ gap.evidence_summary }}</p>
              <p class="meta-text"><strong>{{ view.labels['label_action'] }}</strong>{{ gap.suggested_action }}</p>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="card" style="margin-top:18px">
        <h3>{{ view.labels['label_your_5_axes'] }}</h3>
        <div class="note">{{ view.labels['label_strongest_dim_prefix'] }}{{ view.capability.strongest_label }} · {{ view.labels['label_weakest_dim_prefix'] }}{{ view.capability.weakest_label }}</div>
        {% for dim in view.capability.dimensions %}
        <div class="metric" id="{{ dim.key }}">
          <div class="metric-head">
            <strong>{{ dim.label }}</strong>
            <span class="score-value">{% if dim.has_data %}{{ '%.1f'|format(dim.score) }}{% else %}&mdash;{% endif %}</span>
          </div>
          <div class="bar"><span style="width: {% if dim.has_data %}{{ dim.score }}{% else %}0{% endif %}%;"></span></div>
          <p class="meta-text">{{ dim.explanation }}</p>
          <p class="meta-text"><strong>{{ view.labels['label_next_move'] }}</strong>{{ dim.next_action }}</p>
        </div>
        {% endfor %}
        {% if view.capability.advanced_features %}
        <div class="advanced-features">
          <div class="advanced-features-head">
            <strong>{{ view.labels.get('label_advanced_features', '高级特性使用') }}</strong>
          </div>
          <p class="meta-text">{{ view.labels.get('label_advanced_features_hint', '') }}</p>
          <div class="advanced-features-chips">
            {% for feature_key, count in view.capability.advanced_features %}
            <span class="advanced-feature-chip">
              {{ view.labels.get('advanced_feature_' ~ feature_key, feature_key) }}
              <em>×{{ count }}</em>
            </span>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
    </section>

    <section class="section" id="section-level-evidence">
      <h2 class="section-title">{{ view.labels['section_level_evidence'] }}</h2>
      <p class="section-sub">{{ view.level_evidence.headline }}</p>
      <div class="note" style="margin-bottom:16px">{{ view.level_evidence.verdict }}</div>
      <div class="evidence-summary">
        <div class="card">
          <div class="summary-kicker">{{ view.labels['label_evidence_progress'] }}</div>
          <div class="progress-chip">{{ view.level_evidence.progress_summary }}</div>
          <p class="small" style="margin-top:10px;"><strong>{{ view.labels['label_target_floor'] }}</strong>{{ view.level_evidence.target_caption }}</p>
        </div>
        <div class="card">
          <div class="summary-kicker">{{ view.labels['label_judgement_framework'] }}</div>
          {% if view.level_evidence.source_note %}
          <p class="small">{{ view.level_evidence.source_note }}</p>
          {% endif %}
          <p class="small"><strong>{{ view.level_evidence.methodology_title }}</strong></p>
          <ul class="list">
            {% for line in view.level_evidence.methodology_lines %}
            <li>{{ line }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {% if view.level_evidence.blockers %}
      <div class="note note--warn">
        <strong>{{ view.level_evidence.blocker_title or view.labels['label_evidence_blockers_default'] }}</strong>
        <ul class="list" style="margin-top:8px">
          {% for blocker in view.level_evidence.blockers %}
          <li>{{ blocker }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      <div class="evidence-list">
        {% set ns = namespace(printed_axes_header=false, printed_system_header=false) %}
        {% for item in view.level_evidence.metrics %}
        {% set is_met = item.status == view.labels['label_met'] %}
        {% set kind = item.kind | default('axis') %}
        {% if kind == 'axis' and not ns.printed_axes_header %}
        <div class="evidence-divider"><span>{{ view.labels.get('label_collaboration_axes', 'Collaboration axes') }}</span></div>
        {% set ns.printed_axes_header = true %}
        {% endif %}
        {% if kind == 'system_layer' and not ns.printed_system_header %}
        <div class="evidence-divider evidence-divider--system"><span>{{ view.labels.get('label_system_layer', 'Systemization layer') }}</span></div>
        {% set ns.printed_system_header = true %}
        {% endif %}
        <div class="evidence-row evidence-row--{{ kind }}">
          <span class="evidence-icon{% if is_met %} met{% else %} unmet{% endif %}">{% if is_met %}✓{% else %}○{% endif %}</span>
          <div class="evidence-body">
            <div class="evidence-label">{{ item.label }} · {{ item.status }}</div>
            <p class="small"><strong>{{ view.labels['label_current_value'] }}</strong>{{ item.current_value }} · <strong>{{ view.labels['label_target_floor'] }}</strong>{{ item.target_value }}</p>
            <p class="meta-text">{{ item.explanation }}</p>
            <div class="evidence-signal">{{ item.raw_signal }}</div>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="section" id="section-level-guide">
      <details class="section-toggle">
      <summary><h2 class="section-title">{{ view.labels['section_level_guide'] }}</h2></summary>
      <p class="section-sub">{{ view.level_guide.headline }}</p>
      <div class="tabs" role="tablist" aria-label="{{ view.labels['label_level_tabs_aria'] }}">
        {% for item in view.level_guide.items %}
        <button
          class="tab-btn{% if item.current %} active{% endif %}"
          type="button"
          data-tab-target="level-{{ item.level }}"
          aria-selected="{{ 'true' if item.current else 'false' }}"
        >
          {{ item.level }} · {{ item.title }}
        </button>
        {% endfor %}
      </div>
      {% for item in view.level_guide.items %}
      <div class="tab-panel{% if item.current %} active{% endif %}" id="level-{{ item.level }}">
        <div class="card">
          <div class="eyebrow">{% if item.current %}{{ view.labels['label_current_level_eyebrow'] }}{% else %}{{ view.labels['label_level_guide_eyebrow'] }}{% endif %}</div>
          <h3 style="margin-top:0">{{ item.level }} · {{ item.title }} · {{ item.score_range }}</h3>
          <p class="small">{{ item.description }}</p>
          <div class="grid-2">
            <div>
              <p class="small"><strong>{{ view.labels['label_typical_signals'] }}</strong></p>
              <ul class="list">
                {% for signal in item.signals %}
                <li>{{ signal }}</li>
                {% endfor %}
              </ul>
            </div>
            <div>
              <p class="small"><strong>{{ view.labels['label_how_to_move_up'] }}</strong></p>
              <div class="note note--growth">{{ item.next_step }}</div>
            </div>
          </div>
        </div>
      </div>
      {% endfor %}
      </details>
    </section>

    {% if view.growth_trajectory and (view.growth_trajectory.available or (view.growth_trajectory.trend and view.growth_trajectory.trend.points|length >= 2)) %}
    <section class="section" id="section-growth-delta">
      <h2 class="section-title">{{ view.labels['section_growth_delta'] }}</h2>
      {% if view.growth_trajectory.trend %}
      <p class="section-sub">{{ view.labels.get('label_trend_subtitle', '近 30 天 AI 协作能力趋势') }}</p>
      <div class="grid-3" style="margin-top:12px">
        <div class="card">
          <div class="kpi-label">{{ view.labels.get('label_trend_summary', '趋势结论') }}</div>
          <div class="kpi-value">{{ view.growth_trajectory.trend.summary_label }}</div>
          <div class="small muted">{{ view.growth_trajectory.trend.summary_text }}</div>
        </div>
        <div class="card">
          <div class="kpi-label">{{ view.labels.get('label_confidence', '置信度') }}</div>
          <div class="small">{{ view.growth_trajectory.trend.confidence_note }}</div>
          <div class="small muted">{{ view.growth_trajectory.trend.data_sufficiency }}</div>
        </div>
        <div class="card">
          <div class="kpi-label">{{ view.labels.get('label_display_points', '展示点位') }}</div>
          <div class="small">{{ view.growth_trajectory.trend.points | length }} {{ view.labels['label_active_days'] }}</div>
          <div class="small muted">{{ view.labels.get('label_display_points_note', '同一天默认展示最后一次快照') }}</div>
        </div>
      </div>

      <div class="grid-2" style="margin-top:16px">
        <div class="card">
          <div style="display:flex; justify-content:space-between; gap:12px; align-items:flex-start;">
            <div>
              <h3>{{ view.labels.get('label_score_trend', '协作指数趋势') }}</h3>
              <p class="small muted">{{ view.growth_trajectory.trend.window_label }}</p>
            </div>
            <div style="text-align:right">
              <div class="kpi-value" style="font-size:1.4rem">{{ view.growth_trajectory.trend.score_series.latest_label }}</div>
              <div class="small muted">{{ view.growth_trajectory.trend.score_series.delta_label }}</div>
            </div>
          </div>
          <svg viewBox="0 0 300 140" style="width:100%; height:200px; overflow:visible">
            {% for tick in view.growth_trajectory.trend.score_series.y_ticks %}
            <line x1="12" y1="{{ tick.y }}" x2="288" y2="{{ tick.y }}" stroke="rgba(148,163,184,0.22)" stroke-width="1"></line>
            <text x="0" y="{{ tick.y + 4 }}" font-size="10" fill="rgba(100,116,139,0.86)">{{ tick.value }}</text>
            {% endfor %}
            {% if view.growth_trajectory.trend.score_series.area_path %}
             <path d="{{ view.growth_trajectory.trend.score_series.area_path }}" fill="hsla(var(--h-primary), 70%, 50%, 0.12)"></path>
            {% endif %}
            <polyline fill="none" stroke="var(--accent)" stroke-width="3" points="{{ view.growth_trajectory.trend.score_series.polyline }}"></polyline>
            {% for point in view.growth_trajectory.trend.score_series.points %}
            <circle cx="{{ point.x }}" cy="{{ point.y }}" r="4" fill="white" stroke="var(--accent)" stroke-width="2"></circle>
            {% if loop.first or loop.last or loop.index0 % 5 == 0 %}
            <text x="{{ point.x }}" y="132" text-anchor="middle" font-size="10" fill="rgba(100,116,139,0.86)">{{ point.date_label }}</text>
            {% endif %}
            {% endfor %}
            {% if view.growth_trajectory.trend.score_series.points %}
            {% set first = view.growth_trajectory.trend.score_series.points[0] %}
            {% set last = view.growth_trajectory.trend.score_series.points[-1] %}
            <text x="{{ first.x }}" y="118" text-anchor="start" font-size="10" fill="rgba(100,116,139,0.86)">{{ view.growth_trajectory.trend.score_series.start_label }}</text>
            <text x="{{ last.x }}" y="118" text-anchor="end" font-size="10" fill="rgba(100,116,139,0.86)">{{ view.growth_trajectory.trend.score_series.end_label }}</text>
            {% endif %}
          </svg>
          <p class="small">{{ view.growth_trajectory.trend.score_series.previous_value }} → {{ view.growth_trajectory.trend.score_series.latest_value }} · {{ view.growth_trajectory.trend.score_series.trend_label }}</p>
        </div>
        <div class="card">
          <h3>{{ view.labels.get('label_axis_trend', '五轴趋势') }}</h3>
          {% for series in view.growth_trajectory.trend.axis_series %}
          <div class="metric">
            <div class="metric-head">
              <strong>{{ series.label }}</strong>
              <span>{{ series.latest_label }} / {{ series.delta_label }}</span>
            </div>
            <svg viewBox="0 0 300 64" style="width:100%; height:72px; overflow:visible">
              {% if series.area_path %}
              <path d="{{ series.area_path }}" fill="{{ series.color }}" fill-opacity="0.12"></path>
              {% endif %}
              <polyline fill="none" stroke="{{ series.color }}" stroke-width="2.5" points="{{ series.polyline }}"></polyline>
              {% for point in series.points %}
              <circle cx="{{ point.x }}" cy="{{ point.y }}" r="3" fill="white" stroke="{{ series.color }}" stroke-width="1.6"></circle>
              {% endfor %}
            </svg>
            <p class="small muted">{{ series.trend_label }}{% if series.insufficient_note %} · {{ series.insufficient_note }}{% endif %}</p>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if view.growth_trajectory.available %}
      <h3 style="margin-top:24px">{{ view.labels.get('label_latest_vs_previous', '本期 vs 上一期变化诊断') }}</h3>
      <p class="muted">{{ view.labels['label_compared_with'] }} {{ view.growth_trajectory.prev_label }}</p>
      <p class="section-sub">{{ view.growth_trajectory.overview }}</p>
      <div class="grid-3" style="margin-top:12px">
        {% for card in view.growth_trajectory.summary_cards %}
        <div class="card">
          <div class="kpi-label">{{ card.label }}</div>
          <div class="kpi-value" style="color:{% if card.tone in ['up', 'high'] %}var(--accent){% elif card.tone in ['down', 'low'] %}var(--friction){% else %}var(--ink){% endif %}">
            {{ card.value }}
          </div>
          <div class="small muted">{{ card.caption }}</div>
        </div>
        {% endfor %}
      </div>
      <div class="note" style="margin-top:12px">{{ view.growth_trajectory.confidence_note }}</div>

      <!-- axis_delta detail moved to compare view -->
      <div class="grid-2" style="margin-top:16px">
        <div class="card">
          <h3>{{ view.labels['label_prompt_quality'] }}</h3>
          {% if view.growth_trajectory.prompt_quality %}
          <p>{{ view.growth_trajectory.prompt_quality.headline }}</p>
          <p class="small">{{ view.growth_trajectory.prompt_quality.summary }}</p>
          <p class="small muted">{{ view.growth_trajectory.prompt_quality.source_note }}</p>
          {% endif %}
          {% if view.growth_trajectory.friction %}
          <div class="note" style="margin-top:12px">
            <strong>{{ view.labels['section_friction_changes'] }}</strong>{{ view.growth_trajectory.friction.summary }}
          </div>
          {% endif %}
        </div>
      </div>
      {% endif %}
    </section>
    {% endif %}

    <section class="section" id="section-prompt-coach">
      <h2 class="section-title">{{ view.labels['section_prompt_coach'] }}</h2>
      <p class="coach-headline">{{ view.prompt_coach.headline }}</p>
      {% if view.prompt_coach.source_note %}
      <p class="small muted">{{ view.prompt_coach.source_note }}</p>
      {% endif %}
      {% if view.prompt_coach.available %}
      <div class="grid-2">
        <div class="coach-card">
          <h3>{{ view.labels['label_current_read'] }}</h3>
          <p class="coach-evidence">{{ view.prompt_coach.evidence_summary }}</p>
          {% if view.prompt_coach.prompt_style %}
          <p class="small"><strong>{{ view.labels.get('label_prompt_style', 'Prompt 类型') }}</strong>{{ view.prompt_coach.prompt_style.label }}</p>
          {% endif %}
          {% if view.prompt_coach.light_state_note %}
          <div class="note">{{ view.prompt_coach.light_state_note }}</div>
          {% endif %}
          {% if view.prompt_coach.prompt_style %}
          <div class="note" style="margin-top:12px">
            {{ view.prompt_coach.prompt_style.coaching_message }}
            {% if view.prompt_coach.prompt_style.evidence %}
            <div class="small" style="margin-top:8px; display:flex; flex-wrap:wrap; gap:6px;">
              {% for item in view.prompt_coach.prompt_style.evidence[:3] %}
              <span class="chip">{{ item }}</span>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          {% endif %}
          {% if view.prompt_coach.closure_guidance %}
          <div class="note" style="margin-top:12px">
            <strong>{{ view.labels.get('label_closure_guidance', '收口方式建议') }}</strong>{{ view.prompt_coach.closure_guidance.coaching_message }}
            {% if view.prompt_coach.closure_guidance.mode %}
            <p class="small muted" style="margin-top:8px">{{ view.labels.get('label_closure_mode_' ~ view.prompt_coach.closure_guidance.mode, '') }}</p>
            {% endif %}
          </div>
          {% endif %}
        </div>
        <div class="card">
          <h3>{{ view.labels.get('label_top_deficits', view.labels['label_frequent_deficits']) }}</h3>
          {% for deficit in view.prompt_coach.top_deficits[:2] %}
          <div class="metric" id="{{ deficit.id }}">
            <div class="metric-head">
              <strong>{{ deficit.label }}</strong>
              <span>{{ deficit.confidence }}</span>
            </div>
            <p class="small">{{ deficit.description }}</p>
            <p class="small muted">{{ deficit.impact }}</p>
          </div>
          {% endfor %}
        </div>
      </div>

      {% if view.prompt_coach.friction_synthesis %}
      <div class="card" style="margin-top:18px">
        <h3>{{ view.labels.get('label_friction_synthesis', '提需求摩擦综合判断') }}</h3>
        {% for item in view.prompt_coach.friction_synthesis[:2] %}
        <div class="metric" style="margin-top:12px" id="{{ item.id }}">
          <p><strong>{{ item.label }}</strong></p>
          <p class="small">{{ item.explanation }}</p>
          <p class="small muted"><strong>{{ view.labels.get('label_next_actions', '下一步') }}：</strong>{{ item.next_action }}</p>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% set real_rewrite_cards = view.prompt_coach.rewrite_cards | selectattr('original') | list %}
      {% if real_rewrite_cards %}
      <div class="grid-2" style="margin-top:18px">
        {% for card in real_rewrite_cards[:2] %}
        <div class="coach-card" id="{{ card.id }}">
          <h3>{{ view.labels.get('label_scene', '场景') }} · {{ card.scene }}</h3>
          {% if card.original %}
          <p class="small"><strong>{{ view.labels.get('label_original_prompt', '原始提法') }}</strong></p>
          <div class="code">{{ card.original }}</div>
          {% endif %}
          <p class="coach-tip"><strong>{{ view.labels.get('label_problem', '问题') }}</strong>{{ card.problem }}</p>
          <p class="coach-tip"><strong>{{ view.labels['label_better_prompt'] }}</strong></p>
          <div class="code">{{ card.better_prompt }}</div>
          <p class="coach-tip"><strong>{{ view.labels['label_why_shows_up'] }}</strong>{{ card.why }}</p>
          <p class="small muted">{{ view.labels.get('label_confidence_note', '置信说明：') }}{{ card.confidence }} · {{ card.source_note }}</p>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if view.prompt_coach.prompt_style and view.prompt_coach.prompt_style.suggested_next_prompt %}
      <div class="grid-2" style="margin-top:18px">
        <div class="card">
          <h3>{{ view.labels.get('label_suggested_next_prompt', '下次可以这样问') }}</h3>
          <div class="code">{{ view.prompt_coach.prompt_style.suggested_next_prompt }}</div>
        </div>
        <div class="card">
          <h3>{{ view.labels.get('label_preflight_checklist', '发送前自检') }}</h3>
          <ul class="list">
            {% for item in view.prompt_coach.preflight_checklist[:4] %}
            <li>{{ item.text }}</li>
            {% endfor %}
          </ul>
          {% if view.prompt_coach.closure_guidance and view.prompt_coach.closure_guidance.missing_closure_methods %}
          <p class="small muted"><strong>{{ view.labels.get('label_missing_closure', '当前更适合补：') }}</strong>{{ view.prompt_coach.closure_guidance.missing_closure_methods | join(' / ') }}</p>
          {% endif %}
          {% if view.prompt_coach.recommended_training_inputs %}
          <div class="note note--growth" style="margin-top:12px">{{ view.prompt_coach.recommended_training_inputs[:2] | join(' ') }}</div>
          {% endif %}
        </div>
      </div>
      {% else %}
      <div class="card" style="margin-top:18px">
        <h3>{{ view.labels.get('label_preflight_checklist', '发送前自检') }}</h3>
        <ul class="list">
          {% for item in view.prompt_coach.preflight_checklist[:4] %}
          <li>{{ item.text }}</li>
          {% endfor %}
        </ul>
        {% if view.prompt_coach.closure_guidance and view.prompt_coach.closure_guidance.missing_closure_methods %}
        <p class="small muted"><strong>{{ view.labels.get('label_missing_closure', '当前更适合补：') }}</strong>{{ view.prompt_coach.closure_guidance.missing_closure_methods | join(' / ') }}</p>
        {% endif %}
        {% if view.prompt_coach.recommended_training_inputs %}
        <div class="note note--growth" style="margin-top:12px">{{ view.prompt_coach.recommended_training_inputs[:2] | join(' ') }}</div>
        {% endif %}
      </div>
      {% endif %}

      {% else %}
      <div class="note">{{ view.prompt_coach.headline }}</div>
      {% endif %}
    </section>

    <section class="section" id="section-growth-plan">
      <h2 class="section-title">{{ view.labels['section_growth_plan'] }}</h2>
      {% if view.growth_plan.headline %}
      <p class="section-sub">{{ view.growth_plan.headline }}</p>
      {% endif %}
      {% for priority in view.growth_plan.priorities %}
      <div class="card" style="margin-bottom:16px">
        <h3>{{ priority.title }}</h3>
        {% if priority.why %}
        <p class="priority-why">{{ priority.why }}</p>
        {% else %}
        <p class="priority-why text-muted">
          {{ view.labels['label_heuristic_why_hint'] }}
        </p>
        {% endif %}
        {% if priority.evidence_refs %}
        <p class="small"><strong>{{ view.labels.get('label_training_source', '训练来源：') }}</strong></p>
        <ul class="list">
          {% for evidence in priority.evidence_refs[:3] %}
          <li>{{ evidence }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if priority.linked_prompt_deficit_ids or priority.linked_template_ids or priority.linked_rewrite_card_ids or priority.linked_growth_trend_refs or priority.linked_closure_guidance_ids %}
        <p class="small muted">
          <strong>{{ view.labels.get('label_linked_sources', '关联来源：') }}</strong>
          {% set linked_ids = priority.linked_prompt_deficit_ids + priority.linked_template_ids + priority.linked_rewrite_card_ids + priority.linked_growth_trend_refs + priority.linked_closure_guidance_ids %}
          {% for lid in linked_ids %}
            <span class="jump-link" data-target="{{ lid }}">{{ lid }}</span>
            {% if not loop.last %} / {% endif %}
          {% endfor %}
        </p>
        {% endif %}
        <div class="grid-2">
          {% if priority.week_1_actions %}
          <div>
            <p class="small"><strong>{{ view.labels['label_week1'] }}</strong></p>
            <ul class="list">
              {% for action in priority.week_1_actions %}
              <li>{{ action }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
          {% if priority.week_2_actions %}
          <div>
            <p class="small"><strong>{{ view.labels['label_week2'] }}</strong></p>
            <ul class="list">
              {% for item in priority.week_2_actions %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
        </div>
        {% if priority.practice_prompt %}
        <p class="small"><strong>{{ view.labels['label_practice_prompt'] }}</strong></p>
        <div class="code">{{ priority.practice_prompt }}</div>
        {% endif %}
        {% if priority.action_contract %}
        <p class="small"><strong>{{ view.labels.get('label_action_contract', 'Action contract') }}</strong></p>
        <ul class="list">
          {% for item in priority.action_contract %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        <div class="grid-2" style="margin-top:12px">
          {% if priority.success_signal %}
          <p class="small"><strong>{{ view.labels['label_success_signal'] }}</strong>{{ priority.success_signal }}</p>
          {% endif %}
          {% if priority.stop_doing %}
          <p class="small"><strong>{{ view.labels['label_stop_doing'] }}</strong>{{ priority.stop_doing }}</p>
          {% endif %}
        </div>
      </div>
      {% endfor %}

      <!-- 上期训练回看折叠区块 -->
      <details class="section-toggle" style="margin-top:16px" {% if view.growth_trajectory and view.growth_trajectory.available %}open{% endif %}>
        <summary>
          <span style="font-size:1.1em; font-weight:bold; cursor:pointer;">
            {{ view.labels.get('label_prior_contract_review', '上期训练回看 (Prior Contract Review)') }}
          </span>
        </summary>
        <div style="margin-top: 12px;">
          {% if view.growth_trajectory and view.growth_trajectory.available and view.growth_trajectory.data.latest_vs_previous.contract_outcomes %}
            {% for outcome in view.growth_trajectory.data.latest_vs_previous.contract_outcomes %}
            <div class="card" style="margin-bottom:12px; border-left: 4px solid {% if outcome.status == 'improved' %}var(--success, #10b981){% elif outcome.status == 'partial' %}var(--warning, #f59e0b){% else %}var(--muted, #9ca3af){% endif %};">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; flex-wrap:wrap; gap:6px;">
                <h4 style="margin:0; font-size:1.05em;">{{ outcome.title }}</h4>
                <span class="pill" style="font-size:0.85em; background-color:{% if outcome.status == 'improved' %}rgba(16,185,129,0.1){% elif outcome.status == 'partial' %}rgba(245,158,11,0.1){% else %}rgba(156,163,175,0.1){% endif %}; color:{% if outcome.status == 'improved' %}var(--success, #10b981){% elif outcome.status == 'partial' %}var(--warning, #f59e0b){% else %}var(--text-muted, #6b7280){% endif %};">
                  {% if outcome.status == 'improved' %}已改善 (Improved)
                  {% elif outcome.status == 'partial' %}部分改善 (Partial)
                  {% elif outcome.status == 'unchanged' %}未见明显变化 (Unchanged)
                  {% elif outcome.status == 'no_data' %}数据不足 (No Data)
                  {% else %}评估不匹配 (Mismatch)
                  {% endif %}
                </span>
              </div>
              <p style="margin:4px 0; font-size:0.95em;">{{ outcome.explanation }}</p>
              <div style="display:flex; gap:16px; margin-top:8px; font-size:0.85em; color:var(--text-muted, #6b7280); flex-wrap:wrap;">
                <span>目标轴: {{ outcome.axis_label }}</span>
                {% if outcome.previous_score is not None and outcome.current_score is not None %}
                <span>轴分对比: {{ outcome.previous_score | round(1) }} → {{ outcome.current_score | round(1) }} ({% if outcome.delta >= 0 %}+{% endif %}{{ outcome.delta | round(1) }})</span>
                {% endif %}
                <span>置信度: {% if outcome.confidence == 'high' %}高 (High){% elif outcome.confidence == 'medium' %}中 (Medium){% else %}低 (Low){% endif %}</span>
              </div>
            </div>
            {% endfor %}
          {% else %}
            <div class="card" style="padding:16px; text-align:center; color:var(--text-muted, #6b7280);">
              {{ view.labels.get('label_prior_contract_empty', '首次生成，暂无回看 (No historical contracts available)') }}
            </div>
          {% endif %}
        </div>
      </details>
    </section>

