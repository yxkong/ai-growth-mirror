  <script id="report-data" type="application/json">
    {{ report_data_json | safe }}
  </script>
  <script>
    (function () {
      // 1. DTO parsing and defensive fallback
      function parseData() {
        const el = document.getElementById('report-data');
        if (!el) return { radar_axes: [], gap_rankings: [] };
        try {
          const data = JSON.parse(el.textContent || '{}');
          return {
            radar_axes: data?.scorecard?.radar_axes || [],
            gap_rankings: data?.growth_signals?.gap_rankings || [],
            ...data
          };
        } catch (e) {
          console.error("Failed to parse report-data", e);
          return { radar_axes: [], gap_rankings: [] };
        }
      }
      
      const { radar_axes = [], gap_rankings = [] } = parseData();

      // 2. Tabs logic
      const buttons = Array.from(document.querySelectorAll('[data-tab-target]'));
      const panels = Array.from(document.querySelectorAll('.tab-panel'));
      if (buttons.length && panels.length) {
        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const targetId = button.getAttribute('data-tab-target');
            buttons.forEach((item) => {
              const active = item === button;
              item.classList.toggle('active', active);
              item.setAttribute('aria-selected', active ? 'true' : 'false');
            });
            panels.forEach((panel) => {
              panel.classList.toggle('active', panel.id === targetId);
            });
          });
        });
      }

      // 3. Navigation and IntersectionObserver Scroll Spy
      const navLinks = Array.from(document.querySelectorAll('.sidebar-nav-link, .section-nav-link'));
      const sectionIds = [...new Set(
        navLinks
          .map((link) => (link.getAttribute('href') || '').replace('#', ''))
          .filter(Boolean)
      )];
      const sections = sectionIds
        .map((id) => document.getElementById(id))
        .filter(Boolean)
        .sort((a, b) => a.offsetTop - b.offsetTop);

      let suppressScrollSpyUntil = 0;

      const setActiveLink = (activeId) => {
        navLinks.forEach((link) => {
          const isActive = link.getAttribute('href') === `#${activeId}`;
          link.classList.toggle('active', isActive);
          link.setAttribute('aria-current', isActive ? 'true' : 'false');
        });
      };

      if (navLinks.length && sections.length) {
        setActiveLink(sections[0].id);

        navLinks.forEach((link) => {
          link.addEventListener('click', (event) => {
            const targetId = (link.getAttribute('href') || '').replace('#', '');
            const target = targetId ? document.getElementById(targetId) : null;
            if (!target) return;
            event.preventDefault();
            suppressScrollSpyUntil = Date.now() + 1000;
            setActiveLink(targetId);
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            if (window.history && window.history.replaceState) {
              window.history.replaceState(null, '', `#${targetId}`);
            }
          });
        });

        // IntersectionObserver configuration
        const intersectingSections = new Map();
        const observerOptions = {
          root: null,
          rootMargin: '-15% 0px -60% 0px',
          threshold: 0
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              intersectingSections.set(entry.target.id, entry.target);
            } else {
              intersectingSections.delete(entry.target.id);
            }
          });

          if (Date.now() < suppressScrollSpyUntil) return;

          if (intersectingSections.size > 0) {
            let closest = null;
            let minTopAbs = Infinity;

            intersectingSections.forEach((el) => {
              const rect = el.getBoundingClientRect();
              const topAbs = Math.abs(rect.top - 100);
              if (topAbs < minTopAbs) {
                minTopAbs = topAbs;
                closest = el.id;
              }
            });

            if (closest) {
              setActiveLink(closest);
            }
          }
        }, observerOptions);

        sections.forEach(s => observer.observe(s));
      }

      // 4. Jump Links smooth scroll and gold highlight animation
      document.querySelectorAll('.jump-link').forEach((link) => {
        link.addEventListener('click', (e) => {
          const targetId = link.getAttribute('data-target');
          const targetEl = targetId ? document.getElementById(targetId) : null;
          if (targetEl) {
            e.preventDefault();
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            targetEl.classList.remove('card-highlight');
            void targetEl.offsetWidth; // Trigger reflow
            targetEl.classList.add('card-highlight');
            
            const removeHighlight = () => {
              targetEl.classList.remove('card-highlight');
              targetEl.removeEventListener('animationend', removeHighlight);
            };
            targetEl.addEventListener('animationend', removeHighlight);
          }
        });
      });

      // 5. SVG Radar hover Tooltip positioning and bounding clamp
      const tooltip = document.getElementById('radar-tooltip');
      const hoverZones = document.querySelectorAll('.radar-hover-zone');
      if (tooltip && hoverZones.length) {
        hoverZones.forEach(zone => {
          zone.addEventListener('mouseenter', () => {
            const label = zone.getAttribute('data-label');
            const score = zone.getAttribute('data-score');
            const reason = zone.getAttribute('data-reason');
            
            tooltip.innerHTML = `
              <div class="radar-tooltip-title">
                <span>${label}</span>
                <span class="radar-tooltip-score">${score}</span>
              </div>
              <div class="radar-tooltip-reason">${reason}</div>
            `;
            tooltip.style.display = 'block';
            void tooltip.offsetWidth;
            tooltip.style.opacity = '1';
          });
          
          zone.addEventListener('mousemove', (e) => {
            const tooltipWidth = tooltip.offsetWidth;
            const tooltipHeight = tooltip.offsetHeight;
            let x = e.pageX + 15;
            let y = e.pageY + 15;
            
            if (x + tooltipWidth > window.innerWidth + window.scrollX) {
              x = e.pageX - tooltipWidth - 15;
            }
            if (y + tooltipHeight > window.innerHeight + window.scrollY) {
              y = e.pageY - tooltipHeight - 15;
            }
            
            tooltip.style.left = `${x}px`;
            tooltip.style.top = `${y}px`;
          });
          
          zone.addEventListener('mouseleave', () => {
            tooltip.style.opacity = '0';
            const hideTooltip = () => {
              if (tooltip.style.opacity === '0') {
                tooltip.style.display = 'none';
              }
              tooltip.removeEventListener('transitionend', hideTooltip);
            };
            tooltip.addEventListener('transitionend', hideTooltip);
          });
        });
      }

      // 5b. SVG Trend hover Tooltip positioning
      const trendTooltip = document.querySelector('.trend-tooltip');
      const trendPoints = document.querySelectorAll('.trend-point');
      if (trendTooltip && trendPoints.length) {
        trendPoints.forEach(point => {
          point.addEventListener('mouseenter', () => {
            const date = point.getAttribute('data-date');
            const val = point.getAttribute('data-val');
            trendTooltip.innerHTML = `<strong>${date}</strong>: ${val}`;
            trendTooltip.style.display = 'block';
            trendTooltip.style.opacity = '1';
          });
          
          point.addEventListener('mousemove', (e) => {
            const container = point.closest('.trend-section');
            if (container) {
              const rect = container.getBoundingClientRect();
              const x = e.clientX - rect.left + 15;
              const y = e.clientY - rect.top + 15;
              trendTooltip.style.left = `${x}px`;
              trendTooltip.style.top = `${y}px`;
            }
          });
          
          point.addEventListener('mouseleave', () => {
            trendTooltip.style.display = 'none';
            trendTooltip.style.opacity = '0';
          });
        });
      }

      // 6. Manual three-state theme toggler with localstorage safety sandbox
      const updateThemeUI = (theme, mode) => {
        const statusEl = document.getElementById('theme-toggle-status');
        if (statusEl) {
          statusEl.textContent = mode === 'auto' ? `Auto (${theme})` : (theme === 'dark' ? 'Dark' : 'Light');
        }
      };

      const setTheme = (theme, mode) => {
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        }
        window.__theme = theme;
        updateThemeUI(theme, mode);
        try {
          if (mode === 'auto') {
            localStorage.removeItem('growth-mirror-theme');
          } else {
            localStorage.setItem('growth-mirror-theme', theme);
          }
        } catch (e) {
          console.warn('localStorage write failed:', e);
        }
      };

      let storedTheme = null;
      try {
        storedTheme = localStorage.getItem('growth-mirror-theme');
      } catch (e) {}

      let initialMode = storedTheme ? 'manual' : 'auto';
      updateThemeUI(window.__theme, initialMode);

      const toggleTheme = () => {
        let currentStored = null;
        try {
          currentStored = localStorage.getItem('growth-mirror-theme');
        } catch (e) {}

        if (!currentStored) {
          const next = window.__theme === 'dark' ? 'light' : 'dark';
          setTheme(next, 'manual');
        } else {
          if (currentStored === 'light') {
            setTheme('dark', 'manual');
          } else if (currentStored === 'dark') {
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            setTheme(prefersDark ? 'dark' : 'light', 'auto');
          }
        }
      };

      const btn = document.getElementById('theme-toggle-btn');
      const mobileBtn = document.getElementById('mobile-theme-toggle');
      if (btn) btn.addEventListener('click', toggleTheme);
      if (mobileBtn) mobileBtn.addEventListener('click', toggleTheme);

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        let currentStored = null;
        try {
          currentStored = localStorage.getItem('growth-mirror-theme');
        } catch (e) {}
        if (!currentStored) {
          setTheme(e.matches ? 'dark' : 'light', 'auto');
        }
      });
    })();
  </script>
</body>
</html>
