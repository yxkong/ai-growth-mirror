        <div class="coach-card">
          <h3>{{ view.labels['label_current_read'] }}</h3>
          <p class="coach-evidence">{{ view.prompt_coach.evidence_summary }}</p>
          {% if view.prompt_coach.prompt_style %}
          <p class="small"><strong>{{ view.labels.get('label_prompt_style', 'Prompt 类型') }}</strong>{{ view.prompt_coach.prompt_style.label }}</p>
          {% endif %}
          {% if view.prompt_coach.light_state_note %}
          <div class="note">{{ view.prompt_coach.light_state_note }}</div>
          {% endif %}
          {% if view.prompt_coach.prompt_style %}
          <div class="note" style="margin-top:12px">
            {{ view.prompt_coach.prompt_style.coaching_message }}
            {% if view.prompt_coach.prompt_style.evidence %}
            <ul class="list" style="margin-top:8px">
              {% for item in view.prompt_coach.prompt_style.evidence %}
              <li class="small">{{ item }}</li>
              {% endfor %}
            </ul>
            {% endif %}
            {% if view.prompt_coach.prompt_style.trigger_maturity %}
            <ul class="list" style="margin-top:8px">
              {% for item in view.prompt_coach.prompt_style.trigger_maturity %}
              <li class="small muted">{{ item }}</li>
              {% endfor %}
            </ul>
            {% endif %}
          </div>
          {% endif %}
          {% if view.prompt_coach.closure_guidance %}
          <div class="note" style="margin-top:12px">
            <strong>{{ view.labels.get('label_closure_guidance', '收口方式建议') }}</strong>{{ view.prompt_coach.closure_guidance.coaching_message }}
          </div>
          {% endif %}
        </div>
        <div class="card">
          <h3>{{ view.labels.get('label_top_deficits', view.labels['label_frequent_deficits']) }}</h3>
          {% for deficit in view.prompt_coach.top_deficits[:2] %}
          <div class="metric">
            <div class="metric-head">
              <strong>{{ deficit.label }}</strong>
              <span>{{ deficit.confidence }}</span>
            </div>
            <p class="small">{{ deficit.description }}</p>
            <p class="small muted">{{ deficit.impact }}</p>
          </div>
          {% endfor %}
          <p class="small muted" style="margin-top:12px">
            {{ view.labels.get('label_source_boundary', '来源说明：') }}
            LLM {{ view.prompt_coach.source_summary.llm_session_count }} /
            heuristic {{ view.prompt_coach.source_summary.heuristic_session_count }} /
            light {{ view.prompt_coach.source_summary.light_session_count }}
          </p>
        </div>
      </div>

      {% if view.prompt_coach.rewrite_cards %}
      <div class="grid-2" style="margin-top:18px">
        {% for card in view.prompt_coach.rewrite_cards[:2] %}
        <div class="coach-card">
          <h3>{{ view.labels.get('label_scene', '场景') }} · {{ card.scene }}</h3>
          {% if card.original %}
          <p class="small"><strong>{{ view.labels.get('label_original_prompt', '原始提法') }}</strong></p>
          <div class="code">{{ card.original }}</div>
          {% endif %}
          <p class="coach-tip"><strong>{{ view.labels.get('label_problem', '问题') }}</strong>{{ card.problem }}</p>
          <p class="coach-tip"><strong>{{ view.labels['label_better_prompt'] }}</strong></p>
          <div class="code">{{ card.better_prompt }}</div>
          <p class="coach-tip"><strong>{{ view.labels['label_why_shows_up'] }}</strong>{{ card.why }}</p>
          <p class="small muted">{{ view.labels.get('label_confidence_note', '置信说明：') }}{{ card.confidence }} · {{ card.source_note }}</p>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      <div class="grid-2" style="margin-top:18px">
        <div class="card">
          <h3>{{ view.labels.get('label_suggested_next_prompt', '下次可以这样问') }}</h3>
          {% if view.prompt_coach.prompt_style and view.prompt_coach.prompt_style.suggested_next_prompt %}
          <div class="code">{{ view.prompt_coach.prompt_style.suggested_next_prompt }}</div>
          {% elif view.prompt_coach.universal_template %}
          <div class="code">{{ view.prompt_coach.universal_template.template }}</div>
