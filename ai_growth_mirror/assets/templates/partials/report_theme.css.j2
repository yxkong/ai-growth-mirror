{# Shared report theme tokens. theme_variant: personal | snapshot #}
{% set variant = theme_variant | default('personal') %}
{% if variant == 'snapshot' %}
:root {
  --bg: #f7f3eb;
  --paper: #fffdf8;
  --ink: #18242d;
  --muted: #66747e;
  --line: #e7dece;
  --separator: #ece5d8;
  --accent: #0f766e;
  --accent-strong: #065f46;
  --accent-soft: #d8f5ee;
  --accent-light: #19b8a5;
  --warm: #b45309;
  --warm-soft: #fff2db;
  --hero: #114a46;
  --hero-mid: #0f766e;
  --link: #0f766e;
  --shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
  --bar-track: #ece5d8;
  --bar-end: #0f766e;
  --badge: #0f766e;
  --code-bg: #0f172a;
  --code-fg: #e2e8f0;
  --pill-bg: #f1f5f9;
  --pill-fg: #475569;
  --evidence-met: #12564f;
  --evidence-unmet: #94a3b8;
  --note-border: #c7d2fe;
  --good: #059669;
  --warn: #b45309;
}
{% else %}
{# Cyber Dark Theme: dark slate canvas + Glassmorphism properties #}
:root {
  /* HSL Core Hues */
  --h-primary: 250;      /* Cyber Indigo */
  --h-growth: 150;       /* Emerald Green (Positive Signals) */
  --h-friction: 35;      /* Amber Yellow (Blockers/Friction) */
  --h-neutral: 220;      /* Deep Slate Blue (Canvas Base) */

  /* Dark Theme Palette */
  --bg: hsl(var(--h-neutral), 35%, 6%);
  --paper: hsla(var(--h-neutral), 30%, 10%, 0.65);
  --ink: hsl(var(--h-neutral), 20%, 95%);
  --muted: hsl(var(--h-neutral), 12%, 72%);
  --line: hsla(var(--h-neutral), 20%, 80%, 0.08);
  --separator: hsla(var(--h-neutral), 20%, 80%, 0.06);

  /* Reflection Layer & Accent colors */
  --accent: hsl(var(--h-primary), 75%, 65%);
  --accent-strong: hsl(var(--h-primary), 80%, 75%);
  --accent-soft: hsla(var(--h-primary), 70%, 50%, 0.16);
  --accent-light: hsl(200, 85%, 60%);
  --accent-warm: hsl(var(--h-primary), 70%, 80%);

  /* Growth & friction semantics */
  --growth: hsl(var(--h-growth), 70%, 50%);
  --growth-soft: hsla(var(--h-growth), 70%, 50%, 0.12);
  --friction: hsl(var(--h-friction), 80%, 55%);
  --friction-soft: hsla(var(--h-friction), 80%, 55%, 0.12);
  --warm: hsl(var(--h-friction), 80%, 55%);
  --warm-soft: hsla(var(--h-friction), 80%, 55%, 0.08);
  --link: hsl(var(--h-primary), 75%, 68%);

  /* Shadow & indicators */
  --shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
  --bar-track: hsla(var(--h-neutral), 20%, 80%, 0.08);
  --bar-end: hsl(var(--h-primary), 75%, 65%);
  --badge: linear-gradient(135deg, hsl(var(--h-primary), 75%, 60%) 0%, hsl(var(--h-primary), 60%, 50%) 55%, hsl(200, 80%, 55%) 100%);
  --code-bg: hsl(var(--h-neutral), 30%, 8%);
  --code-fg: hsl(var(--h-neutral), 15%, 88%);
  --pill-bg: hsla(var(--h-primary), 70%, 50%, 0.14);
  --pill-fg: hsl(var(--h-primary), 75%, 75%);
  --evidence-met: hsl(var(--h-growth), 70%, 50%);
  --evidence-unmet: hsl(var(--h-neutral), 10%, 48%);
  --note-border: hsla(var(--h-primary), 70%, 50%, 0.22);
  --good: var(--growth);
  --warn: var(--friction);

  /* Deep space radial glow page background */
  --page-bg:
    radial-gradient(ellipse 70% 55% at 8% -8%, hsla(var(--h-primary), 65%, 45%, 0.18), transparent 58%),
    radial-gradient(ellipse 55% 45% at 92% 4%, hsla(200, 80%, 50%, 0.12), transparent 52%),
    radial-gradient(ellipse 45% 35% at 72% 96%, hsla(var(--h-primary), 70%, 50%, 0.08), transparent 55%),
    linear-gradient(180deg, hsl(var(--h-neutral), 35%, 6%) 0%, hsl(var(--h-neutral), 30%, 8%) 48%, hsl(var(--h-neutral), 35%, 5%) 100%);

  /* Sidebar styling */
  --sidebar-bg: hsla(var(--h-neutral), 30%, 9%, 0.75);
  --sidebar-border: hsla(var(--h-neutral), 20%, 80%, 0.06);
  --sidebar-link-bg: hsla(var(--h-neutral), 20%, 80%, 0.03);
  --sidebar-link-border: hsla(var(--h-neutral), 20%, 80%, 0.04);
  --sidebar-link-ink: hsl(var(--h-neutral), 12%, 80%);

  /* Hero styling */
  --hero-surface:
    linear-gradient(145deg, hsla(var(--h-neutral), 30%, 11%, 0.72) 0%, hsla(var(--h-neutral), 25%, 10%, 0.65) 42%, hsla(var(--h-neutral), 30%, 9%, 0.62) 100%);
  --hero-border: hsla(var(--h-neutral), 20%, 80%, 0.08);
  --hero-ink: hsl(var(--h-neutral), 20%, 96%);
  --hero-muted: hsl(var(--h-neutral), 12%, 75%);
  --hero-accent-line: linear-gradient(90deg, hsl(var(--h-primary), 75%, 65%), hsl(var(--h-primary), 60%, 55%), hsl(200, 85%, 60%));
  --hero-glass: hsla(var(--h-neutral), 20%, 80%, 0.03);
  --hero-glass-border: hsla(var(--h-neutral), 20%, 80%, 0.05);
  --hero-card-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  --hero-chip-bg: linear-gradient(135deg, hsla(var(--h-neutral), 20%, 80%, 0.04), hsla(var(--h-neutral), 20%, 80%, 0.02));
  --hero-chip-border: hsla(var(--h-neutral), 20%, 80%, 0.06);
  --hero-chip-ink: hsl(var(--h-primary), 75%, 78%);
  --hero-strip-bg: linear-gradient(90deg, hsla(var(--h-neutral), 20%, 80%, 0.04), hsla(var(--h-neutral), 20%, 80%, 0.02));
  --hero-strip-border: hsla(var(--h-neutral), 20%, 80%, 0.05);
  
  --hero-num-gradient: linear-gradient(135deg, hsl(var(--h-primary), 80%, 75%) 0%, hsl(var(--h-primary), 70%, 65%) 38%, hsl(200, 85%, 60%) 100%);
  --hero-level-gradient: linear-gradient(135deg, hsl(var(--h-primary), 80%, 70%) 0%, hsl(var(--h-primary), 70%, 65%) 45%, hsl(200, 85%, 60%) 100%);
  
  --hero-nav-bg: hsla(var(--h-neutral), 30%, 8%, 0.6);
  --hero-nav-border: hsla(var(--h-neutral), 20%, 80%, 0.05);
  --hero-nav-ink: hsl(var(--h-neutral), 12%, 75%);
  --hero-nav-active-bg: linear-gradient(135deg, hsl(var(--h-primary), 70%, 60%), hsl(var(--h-primary), 60%, 50%));
  --hero-nav-active-border: transparent;
  --hero-nav-active-ink: #ffffff;

  --overview-signal-bg: linear-gradient(160deg, hsla(var(--h-neutral), 30%, 10%, 0.6) 0%, hsla(var(--h-growth), 70%, 50%, 0.05) 100%);
  --overview-focus-bg: linear-gradient(160deg, hsla(var(--h-neutral), 30%, 10%, 0.6) 0%, hsla(var(--h-friction), 80%, 55%, 0.05) 100%);
  --overview-method-bg: linear-gradient(160deg, hsla(var(--h-neutral), 30%, 10%, 0.6) 0%, hsla(var(--h-primary), 70%, 50%, 0.05) 100%);

  --section-bg: hsla(var(--h-neutral), 30%, 9%, 0.7);
  --section-border: hsla(var(--h-neutral), 20%, 80%, 0.06);
  --section-accent: linear-gradient(90deg, hsl(var(--h-primary), 75%, 65%), hsl(var(--h-primary), 60%, 55%), hsl(200, 85%, 60%));
  
  --card-bg: hsla(var(--h-neutral), 30%, 10%, 0.65);
  --card-border: hsla(var(--h-neutral), 20%, 80%, 0.06);
  --note-bg: linear-gradient(180deg, hsla(var(--h-neutral), 30%, 10%, 0.5) 0%, hsla(var(--h-neutral), 30%, 8%, 0.5) 100%);
  
  --chart-grid: hsla(var(--h-neutral), 20%, 80%, 0.06);
  --chart-line: hsla(var(--h-primary), 70%, 50%, 0.15);
  --chart-fill: hsla(var(--h-primary), 70%, 50%, 0.12);
  --chart-stroke: hsl(var(--h-primary), 75%, 65%);
}
{% endif %}

{% if variant == 'snapshot' %}
body {
  background: linear-gradient(180deg, #fffaf1 0%, var(--bg) 100%);
}
{% else %}
body {
  background: var(--page-bg);
}
{% endif %}

.hero {
  background: var(--hero-surface);
  color: var(--hero-ink);
  border: 1px solid var(--hero-border);
}
.hero::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 4px;
  background: var(--hero-accent-line);
}
.hero::after {
  content: "";
  position: absolute;
  width: 320px;
  height: 320px;
  right: -90px;
  top: -120px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.28) 0%, transparent 68%);
  pointer-events: none;
}
.bar > span {
  background: linear-gradient(90deg, var(--accent), var(--accent-light));
}
.tab-btn.active,
.progress-chip {
  background: var(--accent-soft);
  color: var(--accent-strong);
}
.tab-btn.active {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--tab-active-fg, #fff);
}
.badge-level {
  background: var(--badge);
  color: #fff;
  box-shadow: 0 8px 20px rgba(124, 58, 237, 0.25);
}
details summary,
.theme-link {
  color: var(--link);
}

/* Premium Micro-animations & Monospace Pairing */
.card, .hero-usage-card, .hero-usage-inline-item, .hero-kpi, .sidebar-card, .sidebar-nav-link, .tab-btn {
  transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.22s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.22s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.22s cubic-bezier(0.4, 0, 0.2, 1);
}
.card:hover, .hero-usage-card:hover, .hero-usage-inline-item:hover, .hero-kpi:hover {
  transform: translateY(-2px);
  border-color: var(--border-active, hsl(var(--h-primary, 250), 75%, 65%));
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45), 0 0 20px hsla(var(--h-primary, 250), 70%, 50%, 0.14);
}
.data-num, .hero-kpi-num, .hero-usage-inline-value, .hero-usage-value, .hero-badge-level, .hero-score, .badge-level {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", "Fira Code", monospace;
  letter-spacing: -0.03em;
}

