# Enforce LF line endings in the repository (no CRLF workaround).
* text=auto eol=lf

# Explicit text types
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.j2   text eol=lf
*.css  text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.sh   text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
